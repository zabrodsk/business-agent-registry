{
  "name": "business-agent-registry",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/registry",
    "packages/agent-client"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "npm run build -w @business-registry/client",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run build && npm test --workspaces --if-present",
    "start": "node --env-file-if-exists=.env --import tsx apps/registry/src/server.ts",
    "start:registry": "npm start"
  }
}
